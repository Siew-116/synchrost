# StudyBiz AI - Environment Variables

# Application
APP_ENV=development

# Database
# For development: SQLite
DATABASE_URL=sqlite:///./data/studybiz.db
# For production: PostgreSQL
# DATABASE_URL=postgresql://user:password@host:5432/studybiz

# JWT Authentication
JWT_SECRET_KEY=dormathon2026-studybiz-ai-secret-key-change-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Model (optional - set to "none" for deterministic mode)
AI_MODEL_PROVIDER=none
# AI_MODEL_PROVIDER=openai
# AI_MODEL_API_KEY=sk-...
# AI_MODEL_BASE_URL=https://api.openai.com/v1
# AI_MODEL_NAME=gpt-4o-mini

# Railway
# PORT=8000
