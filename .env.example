# StudyBiz AI - Environment Configuration
# Copy this file to .env and fill in your values.

# Application
APP_NAME=StudyBiz AI
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-key

# Database (SQLite for simplicity - no external setup needed)
DATABASE_URL=sqlite:///./studybiz.db

# Telegram Bot Integration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Set to true when you have valid credentials and webhook configured
TELEGRAM_CONNECTED=false
# Webhook URL (your public URL for receiving Telegram updates)
TELEGRAM_WEBHOOK_URL=

# AI / LLM Provider (optional - runs in deterministic demo mode without it)
# Supports OpenAI-compatible API
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Demo Mode (runs without external credentials)
DEMO_MODE=true

# Exam Mode (reduces notifications, queues non-urgent decisions)
EXAM_MODE=false

# Server
HOST=0.0.0.0
PORT=8000
